# DreamEffect — variables d'environnement

# ---------------------------------------------------------------------------
# Requis — Supabase / runtime
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# URL canonique du site (www recommandé)
NEXT_PUBLIC_SITE_URL=https://www.dreameffect.fr

# Auth Supabase — dans le dashboard Authentication → URL Configuration :
# - Site URL : https://www.dreameffect.fr
# - Redirect URLs : https://www.dreameffect.fr/auth/callback
# Activez aussi « Confirm email » / invitations email (SMTP ou provider).

# ---------------------------------------------------------------------------
# Contact / WhatsApp
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE=06 16 32 03 81
NEXT_PUBLIC_CONTACT_EMAIL=contact@dreameffect.fr
# Numéro WhatsApp sans + (ex. 33616320381) — sinon dérivé du téléphone
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# NAP — adresse identique à la fiche Google Business Profile
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_CITY=Beauvais
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=60000
NEXT_PUBLIC_BUSINESS_REGION=Oise

# ---------------------------------------------------------------------------
# Mentions légales — défauts code = DREAMEFFECT (SIREN 108 889 791)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_LEGAL_NAME=DREAMEFFECT
# NEXT_PUBLIC_LEGAL_FORM=SAS
# NEXT_PUBLIC_LEGAL_CAPITAL=1 000 €
